  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mayank-1024/n8n-nodes-remotive.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
