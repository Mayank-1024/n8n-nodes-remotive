  "homepage": "https://github.com/Mayank-1024/n8n-nodes-remotive",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "remotive",
    "jobs"
  ],
  "author": {
    "name": "Mayank Bhadrasen",
    "email": "181821210+Mayank-1024@users.noreply.github.com",
